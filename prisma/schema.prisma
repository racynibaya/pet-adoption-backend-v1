generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  hashedPassword String
  firstName      String
  lastName       String
  address        String?
  phoneNumber    String?
  role           Role    @default(USER)

  isVerified        Boolean   @default(false)
  verifyToken       String?
  verifyTokenExpiry DateTime?
  refreshToken      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  adoptionRequests AdoptionRequest[]
  shelterStaffs    ShelterStaff[]
  shelters         Shelter[]
  donations        Donation[]

  @@index([role])
}

model Pet {
  id          Int       @id @default(autoincrement())
  name        String
  status      PetStatus @default(AVAILABLE)
  species     Species
  breed       String
  ageMonths   Int
  gender      Gender
  size        Size
  description String

  shelterId        Int
  shelter          Shelter           @relation(fields: [shelterId], references: [id], onDelete: Restrict)
  images           PetImage[]
  bookings         Booking[]
  adoptionRequests AdoptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([shelterId])
  @@index([species])
}

model PetImage {
  id        Int     @id @default(autoincrement())
  petId     Int
  imageUrl  String
  publicId  String
  isPrimary Boolean @default(false)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([petId])
}

model Booking {
  id        Int  @id @default(autoincrement())
  userId    Int
  petId     Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet       Pet  @relation(fields: [petId], references: [id], onDelete: Restrict)

  status    BookingStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([petId])
  @@index([status])
}

model AdoptionRequest {
  id              Int                   @id @default(autoincrement())
  petId           Int
  userId          Int
  message         String?
  rejectionReason String?
  status          AdoptionRequestStatus @default(PENDING)

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([petId])
  @@index([userId])
  @@index([status])
}

model Shelter {
  id           Int    @id @default(autoincrement())
  name         String
  description  String
  address      String @unique
  contactEmail String @unique
  phoneNumber  String
  ownerId      Int

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  shelterStaffs ShelterStaff[]
  pets          Pet[]
  donations     Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ShelterStaff {
  id        Int @id @default(autoincrement())
  userId    Int
  shelterId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shelterId])
  @@index([shelterId])
}

model Donation {
  id                    Int            @id @default(autoincrement())
  amountCents           Int
  currency              String         @default("usd")
  status                DonationStatus @default(PENDING)
  stripePaymentIntentId String?        @unique
  stripeSessionId       String?        @unique
  message               String?

  userId    Int?
  shelterId Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shelter   Shelter? @relation(fields: [shelterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([shelterId])
  @@index([status])
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum PetStatus {
  PENDING
  AVAILABLE
  ADOPTED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdoptionRequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  CANCELLED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum Species {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum Size {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}
