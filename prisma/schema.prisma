generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  hashedPassword String
  name           String
  address        String?
  phoneNumber    String?
  role           Role    @default(USER)

  isVerified Boolean @default(false)

  verifyToken       String?
  verifyTokenExpiry DateTime?
  refreshToken      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  adoptionRequests AdoptionRequest[]
  shelterStaffs    ShelterStaff[]
  shelters         Shelter[]
}

model Pet {
  id          Int       @id @default(autoincrement())
  name        String
  status      PetStatus @default(AVAILABLE)
  breed       String
  species     String
  photo       String
  description String

  shelterId       Int
  shelter         Shelter           @relation(fields: [shelterId], references: [id])
  bookings        Booking[]
  adoptionRequest AdoptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  pet    Pet  @relation(fields: [petId], references: [id])
  petId  Int

  status    BookingStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AdoptionRequest {
  id Int @id @default(autoincrement())

  petId           Int
  userId          Int
  message         String?
  rejectionReason String?
  pet             Pet                   @relation(fields: [petId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])
  status          AdoptionRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, petId])
}

model Shelter {
  id            Int            @id @default(autoincrement())
  name          String
  description   String
  address       String
  contactEmail  String
  phoneNumber   String
  ownerId       Int
  owner         User           @relation(fields: [ownerId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shelterStaffs ShelterStaff[]
  pets          Pet[]
}

model ShelterStaff {
  id        Int @id @default(autoincrement())
  userId    Int
  shelterId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  shelter Shelter @relation(fields: [shelterId], references: [id])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum PetStatus {
  PENDING
  AVAILABLE
  ADOPTED
}

enum AdoptionRequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  CANCELLED
}
