{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "outDir": "dist",

    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],

      "@modules/*": ["modules/*"],

      "@utils/*": ["utils/*"],

      "@models/*": ["models/*"],

      "@middlewares": ["middlewares"]
    }
  },
  "exclude": ["node_modules", "**/*.spec.ts"]
}
